# Copy to .env.prod.local (git-ignored, chmod 600) and fill in. Used by docker-compose.prod.yaml.
#   cp .env.prod.local.dist .env.prod.local && chmod 600 .env.prod.local

# compose
APP_IMAGE=tile-expert-test
APP_TAG=latest
MANTICORE_VERSION=32.1.3
# run doctrine migrations when php-fpm starts (1/0)
RUN_MIGRATIONS=1

# database (the mysql service is created with these credentials on first start)
# generate: openssl rand -hex 24  (hex only: no characters that break DATABASE_URL)
MYSQL_DATABASE=tile_expert_test
MYSQL_USER=tile_expert_test
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=!ChangeMe!

# application
# generate: openssl rand -hex 32
APP_SECRET=!ChangeMe!
TIMEZONE=UTC
# public domain: used by the Traefik router rule
APP_DOMAIN=example.com
DEFAULT_URI=https://example.com/
# regex of the origins allowed to call the API from a browser (escape the dots, add origins with \|)
CORS_ALLOW_ORIGIN=^https://example\.com$

# GET /api/products: page of tile.expert and how long a found price is cached (seconds)
PRODUCT_PAGE_URL_TEMPLATE=https://tile.expert/it/tile/%s/%s/a/%s
PRODUCT_PRICE_CACHE_TTL=3600
