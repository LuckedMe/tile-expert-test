# Local-only additions. Copy to docker-compose.override.yaml (git-ignored); docker compose merges it automatically.
# Example: expose the app through the shared nginx reverse proxy (https://tile-expert-test.local).
services:
    php-fpm:
        networks:
            - shared-smtp

    nginx:
        networks:
            - reverse-proxy
        environment:
            - VIRTUAL_PORT=80
            - VIRTUAL_HOST=localhost,tile-expert-test.local
            - HTTPS_METHOD=redirect
            - SELF_SIGNED_HOST=localhost,tile-expert-test.local

    adminer:
        networks:
            - reverse-proxy
        environment:
            - VIRTUAL_PORT=8080
            - VIRTUAL_HOST=adminer.localhost
            - HTTPS_METHOD=redirect
            - SELF_SIGNED_HOST=localhost

networks:
    reverse-proxy:
        name: reverse-proxy
        external: true
    shared-smtp:
        name: shared-smtp
        external: true
